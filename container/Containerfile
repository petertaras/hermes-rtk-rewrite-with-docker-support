# Add the RTK binary to an existing Hermes terminal-backend image.
#
# The rtk-rewrite-docker plugin rewrites a command on the Hermes host, but the
# rewritten command (for example `rtk read a.txt`) runs INSIDE the container.
# If the image has no `rtk`, the command fails with "rtk: command not found".
# This layer adds the pinned, checksum-verified static binary.
#
#   docker build -f container/Containerfile \
#     --build-arg BASE_IMAGE=localhost/my-image:1.0 \
#     -t localhost/my-image:1.0-rtk1.1.0 container/
#
# x86_64 Linux only (the release asset is a static musl build). The base image
# needs curl, tar and sha256sum. To change version, update BOTH build args and
# take the checksum from the release's checksums.txt.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG RTK_VERSION=1.1.0
ARG RTK_SHA256=9454ad1b9489daa57ab0a9f4ebe2faaf4dc82b8a0f26c9e5135151abd7c9378d

# RTK telemetry stays off inside the sandbox (RTK also defaults to "never asked").
ENV RTK_TELEMETRY_DISABLED=1

USER root
RUN set -eu; \
    [ "$(uname -m)" = "x86_64" ] || { echo "rtk layer supports x86_64 only" >&2; exit 1; }; \
    curl -fsSL -o /tmp/rtk.tar.gz \
      "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-x86_64-unknown-linux-musl.tar.gz"; \
    echo "${RTK_SHA256}  /tmp/rtk.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/rtk.tar.gz -C /usr/local/bin rtk; \
    chmod 0755 /usr/local/bin/rtk; \
    rm -f /tmp/rtk.tar.gz; \
    rtk --version
